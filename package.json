{
  "name": "pi-local-context",
  "version": "0.2.0",
  "description": "Context budgets, recoverable logs, verification loop protection and optional tool declarations for local Pi models.",
  "type": "module",
  "license": "MIT",
  "author": "mredodos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mredodos/pi-local-context.git"
  },
  "bugs": {
    "url": "https://github.com/mredodos/pi-local-context/issues"
  },
  "homepage": "https://github.com/mredodos/pi-local-context#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "local-llm",
    "context",
    "qwen"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions/",
    "lib/",
    "examples/",
    "test/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/fast-compaction.ts",
      "./extensions/context-efficiency.ts",
      "./extensions/loop-guard.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:unit": "node --test test/config.test.mjs test/compaction.test.mjs test/context.test.mjs test/loop-guard.test.mjs",
    "test:integration": "node --test test/*runtime.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@quintinshaw/pi-dynamic-workflows": "3.14.0"
  }
}
